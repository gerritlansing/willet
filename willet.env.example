# willet configuration
#
# Every command-line flag can be set here as WILLET_<FLAG>, with the flag
# name upper-cased and dashes replaced by underscores. Precedence, highest
# first: command-line flag, process environment, this file. Unknown
# WILLET_* keys are rejected at startup, so typos don't go unnoticed.
#
# Copy it, restrict it (it holds credentials), and load it either way:
#
#   willet --env-file /etc/willet.env      # directly
#   EnvironmentFile=/etc/willet.env             # systemd (see README)
#
# Keep values on one line and unquoted so the file reads the same under both;
# systemd's EnvironmentFile does not support multi-line values. Commented-out
# settings show their defaults.

# --- Scale set -----------------------------------------------------------------

# Where to register the scale set: an org, repo or enterprise URL. Required.
# Must be https; the daemon sends GitHub credentials to this host.
#   https://github.com/my-org
#   https://github.com/my-org/my-repo
#   https://github.com/enterprises/my-enterprise
WILLET_URL=https://github.com/my-org

# Scale set name. Must be unique within the runner group. If a scale set with
# this name exists it is reused (and its labels updated), so restarts keep the
# same registration. Required.
WILLET_NAME=willet

# Labels workflows target with runs-on, comma-separated. Defaults to the name.
# On GHES, more than one label needs 3.18+ and a feature flag (see scaleset docs).
#WILLET_LABELS=willet,linux,x64

# Runner group for the scale set. Non-default groups must already exist.
#WILLET_RUNNER_GROUP=default

# Idle runners kept booted and waiting for jobs. Each holds a VM (and its
# memory) permanently, but microVMs boot in well under a second, so 0 is
# usually fine.
#WILLET_MIN_RUNNERS=0

# Maximum concurrent runner VMs. Size the host for MAX_RUNNERS x MEMORY.
#WILLET_MAX_RUNNERS=4

# Remove the scale set from GitHub on shutdown. Leave off for a long-running
# service, otherwise queued jobs lose their target during restarts.
#WILLET_DELETE_ON_EXIT=false

# --- Credentials ---------------------------------------------------------------
# Use a GitHub App (recommended) or a personal access token, not both. If all
# three App settings are present the App is used, so comment them out to use a
# token. Enterprise-level runners need a classic token.
# Required permissions: https://docs.github.com/en/actions/how-tos/manage-runners/use-actions-runner-controller/authenticate-to-the-api

# GitHub App: client ID (the numeric App ID also works) and installation ID.
WILLET_APP_CLIENT_ID=Iv1.0000000000000000
WILLET_APP_INSTALLATION_ID=12345678

# Path to the App's private key PEM. Prefer this to WILLET_APP_PRIVATE_KEY,
# since a PEM is multi-line. The file must be readable by the service user.
WILLET_APP_PRIVATE_KEY_FILE=/etc/willet/app.pem

# Personal access token, as an alternative to a GitHub App. Classic PATs need
# the repo scope (repo level), admin:org (org level) or manage_runners:enterprise
# (enterprise level).
#WILLET_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Runner VMs ----------------------------------------------------------------

# OCI image with the actions runner. Defaults to the willet runner image:
# GitHub's runner image plus iptables for Docker and common build tools. Its
# tags are <runner version>-<revision> (e.g. 2.337.0-1, never changes),
# <runner version> and latest. A custom image must contain run.sh in
# RUNNER_DIR, executable by RUNNER_USER. A tag (like :latest) is re-pulled
# every IMAGE_REFRESH_INTERVAL and new runners are pinned to the digest it
# resolves to. A digest reference (repo@sha256:...) is used as-is and never
# refreshed; you must then update it yourself, since GitHub stops sending jobs
# to runners more than 30 days out of date.
#WILLET_RUNNER_IMAGE=ghcr.io/gerritlansing/willet-runner:latest

# Credentials for pulling RUNNER_IMAGE from a private registry, e.g. a private
# GHCR package (username: any GitHub user, password: a token with read:packages).
# Both or neither. The password is read from a file, like the App key. They are
# used on the host for the pull only; microsandbox never stores them or passes
# them into a VM. Without them, microsandbox falls back to the OS keyring and
# Docker credential helpers (~/.docker/config.json) of the service user.
#WILLET_REGISTRY_USERNAME=my-bot
#WILLET_REGISTRY_PASSWORD_FILE=/etc/willet/registry-token

# How often to re-pull a tagged image, as a Go duration. The runner is released
# every 3-7 weeks, so daily is plenty. 0 disables refreshing (not recommended
# with a tag); otherwise at least 1m.
#WILLET_IMAGE_REFRESH_INTERVAL=24h

# vCPUs and memory (MiB) per VM.
#WILLET_CPUS=2
#WILLET_MEMORY=4096

# Writable root disk per VM in MiB. 0 uses the microsandbox default (about 4 GiB).
#WILLET_DISK=0

# Hard cap on a VM's lifetime, as a Go duration (e.g. 90m, 6h). The VM is killed
# when it is reached, even mid-job. 0 disables the cap; negative values are
# rejected. GitHub's own job timeout also defaults to 6h.
#WILLET_MAX_JOB_DURATION=6h

# Limit on creating one VM, including pulling the image if it isn't cached,
# and on registering its runner. It applies to runner VMs and to the startup
# and refresh VMs. A start that takes longer is abandoned and retried; the VM,
# if one is still being created, is removed once its creation ends.
#WILLET_START_TIMEOUT=10m

# Guest user and directory used to start the runner.
#WILLET_RUNNER_USER=runner
#WILLET_RUNNER_DIR=/home/runner

# Private addresses runner VMs may reach. By default VMs reach only the public
# internet and DNS; private ranges, loopback, cloud metadata and the host are
# denied. Comma-separated IPs or CIDRs, each optionally with :port or
# :port-range (IPv6 with a port: [fd00::1]:443). Hostnames are not accepted.
# A host reached by name (e.g. a GHES server) needs its address allowed
# WITHOUT a port: microsandbox's DNS rebinding protection otherwise drops the
# private DNS answer. The startup check reports what to add if it's missing.
#WILLET_NETWORK_ALLOW=10.0.5.10,10.20.0.0/16:443

# microsandbox's DNS rebinding protection drops private DNS answers unless a
# NETWORK_ALLOW entry covers the address without a port. Setting this to false
# lets private answers through, so a port-restricted entry (10.0.5.10:443) also
# works for a host reached by name. Connections stay limited to the public
# internet and NETWORK_ALLOW either way; what you give up is a defence against
# a malicious public domain resolving to one of your allowed private addresses.
# Your decision; the default keeps microsandbox's protection on.
#WILLET_DNS_REBIND_PROTECTION=true

# Run a Docker daemon in each VM, for jobs that use container:, services: or
# Docker container actions. It starts before the runner, on its own ext4 data
# disk, and adds about a second to each VM's start. The runner image must
# include dockerd and iptables; GitHub's stock actions-runner image has dockerd
# but not iptables. Set false for an image without Docker.
#WILLET_DOCKER=true

# Size of each VM's Docker data disk in MiB (at least 1024). The disk is sparse:
# only space actually used takes up room on the host, and it is removed with
# the VM.
#WILLET_DOCKER_DISK=20480

# Skip the startup warm-up, which pulls the image, pins its digest, boots test
# VMs to check the runner can start and the GitHub server is reachable, so
# misconfiguration fails at start rather than on the first job. When skipped, the image is used as cached until
# the first scheduled refresh.
#WILLET_SKIP_WARMUP=false

# --- Logging -------------------------------------------------------------------

# debug, info, warn or error.
#WILLET_LOG_LEVEL=info

# text or json. Logs go to stderr (the journal under systemd).
#WILLET_LOG_FORMAT=text

# Log each line of the runners' own output, at info level. It is verbose and
# NOT masked the way GitHub masks secrets in job logs; treat it as sensitive.
#WILLET_LOG_RUNNER_OUTPUT=false
